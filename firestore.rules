rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Feedback collection - anyone can create feedback, but not read or modify
    match /feedback/{feedbackId} {
      // Allow anyone to submit feedback
      allow create: if request.resource.data.keys().hasAll(['rating', 'feedback', 'timestamp'])
                    && request.resource.data.rating is int
                    && request.resource.data.rating >= 1
                    && request.resource.data.rating <= 5
                    && request.resource.data.feedback is string
                    && request.resource.data.timestamp == request.time;

      // Allow anyone to read feedback
      allow read: if true;
      // Only allow updating/deleting for authenticated admin users
      allow update, delete: if false;
    }

    // Hosts collection. Public reads stay open. Clients may edit host records,
    // but unavailable_dates is written only by Cloud Functions (admin secret or magic link).
    match /hosts/{hostId} {
      allow read: if true;
      allow create: if !('unavailable_dates' in request.resource.data)
                    || (request.resource.data.unavailable_dates is list
                        && request.resource.data.unavailable_dates.size() == 0);
      allow update: if !request.resource.data.diff(resource.data).affectedKeys().hasAny(['unavailable_dates']);
      allow delete: if true;
    }

    // Special Collections - allow full access for now (we can add authentication later)
    match /specialCollections/{collectionId} {
      allow read, write: if true;
    }

    // Magic link settings are readable in the admin UI. Writes go through
    // the admin Cloud Function, which checks the admin API secret.
    match /settings/{docId} {
      allow read: if true;
      allow write: if false;
    }
  }
}
